-          CORS_BODY='{"rules":[{"allowed":{"origins":["*"],"methods":["GET","HEAD"],"headers":["*"]},"exposeHeaders":["ETag","Content-Length","Accept-Ranges","Content-Range"],"maxAgeSeconds":3600}]}'
