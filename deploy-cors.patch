+              *) ORIGIN="https://$SITE_DOMAIN" ;;
+            esac
+            CORS_BODY=$(jq -n --arg origin "$ORIGIN" '{"rules":[{"allowed":{"origins":[$origin],"methods":["GET","HEAD"],"headers":["*"]},"exposeHeaders":["ETag","Content-Length","Accept-Ranges","Content-Range"],"maxAgeSeconds":3600}]}')
+            ACTION="configured (origin: $ORIGIN, direct-link previews enabled)"
